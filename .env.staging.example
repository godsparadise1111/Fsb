# Staging environment. Copy to .env.staging (never commit it) and replace EVERY secret.
# Every secret must differ from production. Staging must never reuse production credentials.
POSTGRES_DB=fsb_staging
POSTGRES_USER=fsb_staging
POSTGRES_PASSWORD=replace_with_unique_staging_password
API_PORT=3101
WEB_PORT=3100
FSB_DATA_DIR=/srv/fsb-data/staging
CORS_ORIGINS=https://staging.example.internal
NEXT_PUBLIC_API_URL=https://staging.example.internal/api
FSB_PUBLIC_APP_URL=https://staging.example.internal
JWT_SECRET=replace_with_unique_staging_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
BOOTSTRAP_TOKEN=replace_with_unique_staging_one_time_secret
FSB_OUTBOX_ENCRYPTION_KEY=
FSB_METRICS_TOKEN=
# Number of reverse-proxy hops in front of the API (usually 1). Required by the production preflight.
FSB_TRUST_PROXY=1
# Staging must not send real mail to real customers: point SMTP at a capture server (e.g. Mailpit/MailHog).
FSB_SMTP_HOST=
FSB_SMTP_PORT=587
FSB_SMTP_SECURE=false
FSB_SMTP_USER=
FSB_SMTP_PASS=
FSB_EMAIL_FROM=
