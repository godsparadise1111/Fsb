# Local development only. Replace credentials outside source control.
POSTGRES_DB=fsb
POSTGRES_USER=fsb
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432
DB_HOST=localhost
DB_PORT=5432
DB_SYNCHRONIZE=true
API_PORT=3001
# Comma-separated trusted frontend origins; required in production
CORS_ORIGINS=http://localhost:3000
# Optional locally; use a random 32+ character token for protected /api/health/metrics
FSB_METRICS_TOKEN=
WEB_PORT=3000
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
BOOTSTRAP_TOKEN=replace_with_a_separate_one_time_secret
# Required for encrypted notification outbox payloads (generate with: openssl rand -hex 32)
FSB_OUTBOX_ENCRYPTION_KEY=

# Private file storage; keep outside any public/static web directory
FSB_FILE_STORAGE_PATH=./var/private-files
# Enable only in a dedicated worker process; API processes should keep this false
FSB_NOTIFICATION_WORKER_ENABLED=false
# Independent workflow automation worker (SLA-based automatic reassignment)
FSB_WORKFLOW_AUTOMATION_ENABLED=false
FSB_WORKFLOW_POLL_MS=30000
# Conservative crash recovery; enable on one or more API/worker replicas (DB advisory locks coordinate them)
FSB_WORKFLOW_RECOVERY_ENABLED=false
FSB_WORKFLOW_RECOVERY_POLL_MS=60000
FSB_NOTIFICATION_POLL_MS=5000
# Enable only in a dedicated report worker process
FSB_REPORT_WORKER_ENABLED=false
FSB_REPORT_POLL_MS=5000
# TTF font used by Persian PDF exports
FSB_PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
FSB_PUBLIC_APP_URL=http://localhost:3000
FSB_SMTP_HOST=
FSB_SMTP_PORT=587
FSB_SMTP_SECURE=false
FSB_SMTP_USER=
FSB_SMTP_PASS=
FSB_EMAIL_FROM=

# Public API URL baked into the Next.js client bundle during Docker build
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Local development default; production Compose overrides this to production
NODE_ENV=development
